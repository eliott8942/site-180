{
  "name": "hugoplate",
  "version": "1.7.6",
  "author": "zeon.studio",
  "devDependencies": {
    "@fullhuman/postcss-purgecss": "^5.0.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "autoprefixer": "^10.5.4",
    "csv-parse": "^7.0.0",
    "js-yaml": "^4.2.0",
    "markdownlint-cli2": "^0.18.1",
    "postcss": "^8.5.26",
    "postcss-cli": "^10.1.0",
    "stylelint": "^16.26.1",
    "stylelint-config-recommended": "^17.0.0",
    "stylelint-config-recommended-scss": "^16.0.2",
    "tailwind-bootstrap-grid": "^5.1.0",
    "tailwindcss": "^3.4.19"
  },
  "description": "hugo tailwindcss boilerplate",
  "license": "MIT",
  "scripts": {
    "dev": "HUGO_HOST_DOMAIN=localhost:1313 hugo server",
    "build": "HUGO_HOST_DOMAIN=localhost:1313 hugo --gc --minify --templateMetrics --templateMetricsHints --forceSyncStatic",
    "prod": "HUGO_HOST_DOMAIN=localhost:1313 hugo server --disableFastRender --navigateToChanged --templateMetrics --templateMetricsHints --watch --forceSyncStatic -e production --minify",
    "clean": "rm -rf public/ && hugo mod clean",
    "update-modules": "node ./scripts/clearModules.js && hugo mod clean --all && hugo mod get -u ./... && hugo mod tidy",
    "format": "prettier -w .",
    "content-lint": "markdownlint-cli2",
    "style-lint": "stylelint \"**/*.{css,scss,sass}\"",
    "update-members": "bun ./scripts/updateMembersList.js"
  },
  "dependencies": {
    "baseline-browser-mapping": "^2.11.12",
    "caniuse-lite": "^1.0.30001806"
  }
}
